# Copy this file to .env and fill in your values. Never commit .env.
# Business discovery uses OpenStreetMap (Overpass + Nominatim) — no API
# key needed at all.

# --- LLM provider ---
# "ollama" = run a Llama model locally via https://ollama.com
# "groq"   = hosted Llama models via https://console.groq.com (fast, generous free tier)
LLM_PROVIDER=ollama

# Used when LLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434

# Dual-model setup: two local models, routed by task type.
#   worker    -> extraction, summarization, classification (fast/cheap)
#   reasoning -> business reasoning, design, proposal/outreach writing
# Pull them with:  ollama pull qwen2.5:3b   and   ollama pull qwen2.5:7b
#   (these are the Qwen2.5 instruct builds; the `-instruct`-suffixed tags
#    e.g. qwen2.5:3b-instruct are the same models under a longer name)
OLLAMA_WORKER_MODEL=qwen2.5:3b
OLLAMA_REASONING_MODEL=qwen2.5:7b

# How long Ollama keeps a model resident after a call with no further
# requests (conservative for 12GB RAM + HDD). Use "0" to unload immediately.
OLLAMA_KEEP_ALIVE=5m

# Legacy single-model fallback. If you ONLY set OLLAMA_MODEL (and leave the
# two vars above commented out), both roles use it — an existing single-model
# deployment upgrades without breaking.
#OLLAMA_MODEL=llama3.2:3b

# Phased rollout: set to false to run everything on the worker model (the 7B
# reasoning model is then never pulled or loaded).
#REASONING_MODEL_ENABLED=true

# Follow-up drafting escalates from worker to reasoning when a lead's stored
# opportunity/qualification score exceeds this.
#FOLLOWUP_ESCALATION_SCORE=90

# Used when LLM_PROVIDER=groq (role parity for hosted use)
#GROQ_API_KEY=
#GROQ_WORKER_MODEL=llama-3.1-8b-instant
#GROQ_REASONING_MODEL=llama-3.3-70b-versatile

# --- Storage ---
DATABASE_PATH=./data/leads.db

# --- HTTP identification ---
# Nominatim (OpenStreetMap's geocoder) requires a real identifying
# User-Agent for its free public service. Put a real contact here before
# heavy use — see https://operations.osmfoundation.org/policies/nominatim/
HTTP_USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36
