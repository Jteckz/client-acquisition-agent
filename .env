# ── Authentication & API Keys ──────────────────────────────────────────
# REQUIRED: Cryptographic key for signing JWT tokens.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
# NEVER commit this to version control.
SECRET_KEY=a5cb5d31d405b58fa5bc5cef2cde6cf2084a235d2fe8a86cca4fb443a9d9e36a

# REQUIRED: Async PostgreSQL connection string for the auth database.
# Used for users and api_usage tables. The existing SQLite pipeline
# database (leads.db) is separate and unchanged.
DATABASE_URL=postgresql+asyncpg://janxyn:Janxyn123@localhost:5432/client_acquisition_agent

# ── JWT Token Settings ────────────────────────────────────────────────
# How long access tokens live (in minutes). Default: 1440 (24 hours).
# ACCESS_TOKEN_EXPIRE_MINUTES=1440

# How long refresh tokens live (in days). Default: 30.
# REFRESH_TOKEN_EXPIRE_DAYS=30

# ── CORS ──────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Existing LLM settings (unchanged) ────────────────────────────────
LLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_WORKER_MODEL=qwen2.5:3b
OLLAMA_REASONING_MODEL=qwen2.5:7b
OLLAMA_KEEP_ALIVE=5m

# ── Existing storage settings (unchanged) ─────────────────────────────
DATABASE_PATH=./data/leads.db
