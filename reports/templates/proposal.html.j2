<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<style>
  body { font-family: 'Segoe UI', Tahoma, sans-serif; color: #333; margin: 40px; }
  h1 { color: #1a56db; border-bottom: 2px solid #1a56db; padding-bottom: 8px; }
  h2 { color: #1a56db; margin-top: 30px; }
  h3 { color: #374151; }
  .section { margin-bottom: 24px; }
  ul { padding-left: 20px; }
  li { margin-bottom: 6px; }
  .meta { color: #6b7280; font-size: 0.9em; }
  .budget-table { border-collapse: collapse; width: 100%; max-width: 500px; }
  .budget-table td { padding: 8px 12px; border: 1px solid #e5e7eb; }
  .budget-table td:first-child { font-weight: 600; background: #f9fafb; width: 40%; }
  .status-badge { display: inline-block; background: #059669; color: white; padding: 4px 12px; border-radius: 12px; font-size: 0.85em; }
  .footer { margin-top: 40px; border-top: 1px solid #e5e7eb; padding-top: 12px; font-size: 0.8em; color: #9ca3af; }
</style>
</head>
<body>
<h1>{{ business_name }}</h1>
<p class="meta">{{ category }} — Proposal</p>

<div class="section">
<h2>Executive Summary</h2>
<p>{{ summary }}</p>
</div>

<div class="section">
<h2>Identified Challenges</h2>
<ul>
{% for c in challenges %}
<li>{{ c }}</li>
{% else %}
<li>No specific challenges identified</li>
{% endfor %}
</ul>
</div>

<div class="section">
<h2>Proposed Solution: {{ package_name }}</h2>
<h3>Features</h3>
<ul>
{% for f in features %}
<li>{{ f }}</li>
{% endfor %}
</ul>
</div>

<div class="section">
<h2>Technology Stack</h2>
<table class="budget-table">
<tr><td>Frontend</td><td>{{ frontend }}</td></tr>
<tr><td>Backend</td><td>{{ backend }}</td></tr>
<tr><td>Database</td><td>{{ database }}</td></tr>
<tr><td>Hosting</td><td>{{ hosting }}</td></tr>
</table>
</div>

<div class="section">
<h2>Expected Benefits</h2>
<ul>
{% for b in benefits %}
<li>{{ b }}</li>
{% else %}
<li>Improved digital presence and customer engagement</li>
{% endfor %}
</ul>
</div>

<div class="section">
<h2>Budget &amp; Timeline</h2>
<table class="budget-table">
<tr><td>Estimated Cost</td><td>{{ currency }} {{ cost_min | comma }} – {{ currency }} {{ cost_max | comma }}</td></tr>
<tr><td>Estimated Timeline</td><td>{{ weeks_min }} – {{ weeks_max }} weeks</td></tr>
</table>
</div>

<div class="footer">
Generated by Client Acquisition Agent &mdash; {{ package_name }}
</div>
</body>
</html>
